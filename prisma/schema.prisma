// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUBMITTER
  APPROVER
  ADMIN
  PENDING
  REPORTER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

model Site {
  id          String       @id @default(cuid())
  name        String       
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // Relations
  users       User[]
  departments Department[]
  documentTypes DocumentType[]
  documents   Document[]
  templates   Template[]
  feedback    Feedback[]
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String
  password          String
  role              UserRole
  departmentId      String?      // Foreign key to the Department table
  department        Department?  @relation(fields: [departmentId], references: [id])
  siteId            String?      // Foreign key to the Site table
  site              Site?        @relation(fields: [siteId], references: [id])
  resetToken        String?      // Token for password reset
  resetTokenExpiry  DateTime?    // Expiry time for reset token
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  documents         Document[]   @relation("SubmittedDocuments")
  approvals         Document[]   @relation("DocumentApprovals")
  comments          Comment[]    // Relation to comments made by the user
  feedback          Feedback[]   // Relation to feedback submitted by the user
}

model Department {
  id          String       @id @default(cuid())
  name        String       
  description String?
  siteId      String       // Foreign key to the Site table
  site        Site         @relation(fields: [siteId], references: [id])
  users       User[]       @relation
  documents   Document[]   @relation
  templates   Template[]   // Optional relation to templates
  
  @@unique([name, siteId]) // Name must be unique within a site
}

model DocumentType {
  id          String       @id @default(cuid())
  name        String       
  description String?
  siteId      String       // Foreign key to the Site table
  site        Site         @relation(fields: [siteId], references: [id])
  documents   Document[]   @relation
  templates   Template[]   // Optional relation to templates
  
  @@unique([name, siteId]) // Name must be unique within a site
}

model Document {
  id            String         @id @default(cuid())
  name          String
  typeId        String          // Foreign key to the DocumentType table
  type          DocumentType   @relation(fields: [typeId], references: [id])
  description   String
  departmentId  String?         // Foreign key to the Department table
  department    Department?     @relation(fields: [departmentId], references: [id])
  siteId        String          // Foreign key to the Site table
  site          Site            @relation(fields: [siteId], references: [id])
  status        DocumentStatus  @default(PENDING)
  content       Bytes           // Document content stored as bytes
  mimeType      String          // MIME type of the file
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  submitter     User            @relation("SubmittedDocuments", fields: [submitterId], references: [id])
  submitterId   String
  approver      User?           @relation("DocumentApprovals", fields: [approverId], references: [id])
  approverId    String?
  comments      Comment[]       // Relation to document comments
}

model Template {
  id            String         @id @default(cuid())
  name          String
  description   String
  content       Bytes          // Template file content stored as bytes
  mimeType      String         // MIME type of the file
  departmentId  String?        // Optional foreign key to Department table
  department    Department?    @relation(fields: [departmentId], references: [id])
  typeId        String         // Foreign key to DocumentType table
  type          DocumentType   @relation(fields: [typeId], references: [id])
  siteId        String         // Foreign key to the Site table
  site          Site           @relation(fields: [siteId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Comment {
  id          String    @id @default(cuid())
  content     String    // The comment text
  documentId  String    // Foreign key to the Document table
  document    Document  @relation(fields: [documentId], references: [id])
  userId      String    // Foreign key to the User table
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Feedback {
  id          String    @id @default(cuid())
  content     String    // The feedback text
  userId      String    // Foreign key to the User table
  user        User      @relation(fields: [userId], references: [id])
  siteId      String    // Foreign key to the Site table
  site        Site      @relation(fields: [siteId], references: [id])
  status      FeedbackStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
}
